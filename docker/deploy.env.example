# Private deployment selection for the dame-curie instance.
# INSTANCE_ID is the full instance AND service-account name (dame-curie, or
# dame-curie-<identity> for a later replica). INSTANCE_DIR is /srv/<INSTANCE_ID>.
# ENGINE_SOCKET must be that account's own rootless socket: /run/user/<service-uid>/docker.sock.
INSTANCE_ID=dame-curie
INSTANCE_DIR=/srv/dame-curie
ENGINE_SOCKET=/run/user/<service-uid>/docker.sock
APP_IMAGE=dame-curie-app:REPLACE_WITH_RELEASE
DAME_CURIE_STAGING=true
# Optional: local (default, this project's own Ollama) or external (embeddings
# come from an endpoint configured in bot.env, and no local model service or
# model pull starts). Omit the line for local.
DAME_CURIE_EMBED_MODE=local
