[Unit]
Description=Dirac V2 to protected V1 Ollama relay
Documentation=file:/opt/dame-curie/phase-II_v2/DIRAC_RUNTIME_OPS.md
After=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60s

[Service]
Type=simple
# Root is required: the relay enters the V2 daemon's network namespace and binds
# the private outbound-bridge gateway. It never runs as, or acts for, the service
# user, and it never contacts V1 with anything but a read-only inspect.
ExecStart=/bin/sh -ec 'exec /usr/bin/python3 /opt/dame-curie/scripts/dirac_relay.py --network dame-curie_outbound --engine-pid-file /run/user/$(id -u dame-curie)/docker.pid --v1-container maxwell-curie-ollama-1'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
