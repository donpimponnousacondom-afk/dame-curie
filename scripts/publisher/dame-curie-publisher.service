[Unit]
Description=dame-curie public site mirror and image archive
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=dame-curie
Group=dame-curie
WorkingDirectory=/opt/dame-curie
ExecStart=/opt/dame-curie/.venv/bin/python -B -m scripts.publisher --config /srv/dame-curie/publisher/config/publisher.toml
Restart=on-failure
RestartSec=30
# scripts/publisher/service.py reports after each job. On expiry systemd sends SIGABRT, and
# Restart=on-failure restarts the service. The publisher refuses a WatchdogSec that is too
# small for its rescan_seconds and timeout_seconds.
WatchdogSec=30min
NotifyAccess=main
# SIGABRT goes to the main process only. If ssh or rsync died first, a worker that waits for
# it would continue, and the stack would not show the line that hung.
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/dame-curie /srv/dame-curie/sites
ReadWritePaths=/srv/dame-curie/publisher/staging /srv/dame-curie/publisher/state /srv/dame-curie/publisher-status
InaccessiblePaths=-/srv/dame-curie/data -/srv/dame-curie/config -/srv/dame-curie/logs -/srv/dame-curie/shell

[Install]
WantedBy=multi-user.target
