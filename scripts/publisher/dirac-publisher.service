[Unit]
Description=dame-curie Dirac public site mirror and image archive
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=dame-curie
Group=dame-curie
WorkingDirectory=/opt/dame-curie
ExecStart=/opt/dame-curie/.venv/bin/python -B -m scripts.publisher --config /srv/dame-curie/dirac/publisher/config/publisher.toml
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/dame-curie /srv/dame-curie/dirac/sites
ReadWritePaths=/srv/dame-curie/dirac/publisher/staging /srv/dame-curie/dirac/publisher/state
# The Dirac instance's own bot roots, and the canonical instance's bot roots and
# publisher credentials, are hidden: this unit runs as `dame-curie`, the same
# account as both, so file modes cannot separate them. The Dirac publisher's own
# credentials under /srv/dame-curie/dirac/publisher/config stay readable.
InaccessiblePaths=-/srv/dame-curie/config -/srv/dame-curie/data \
                  -/srv/dame-curie/logs -/srv/dame-curie/shell \
                  -/srv/dame-curie/publisher/config \
                  -/srv/dame-curie/dirac/config -/srv/dame-curie/dirac/data \
                  -/srv/dame-curie/dirac/logs -/srv/dame-curie/dirac/shell

[Install]
WantedBy=multi-user.target
